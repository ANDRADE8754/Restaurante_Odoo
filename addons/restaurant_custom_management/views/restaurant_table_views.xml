<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_table_list" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list string="Mesas">
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="location"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form string="Mesa">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_reservations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar">
                            <field
                                name="reservation_count"
                                widget="statinfo"
                                string="Reservas"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="capacity"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_restaurant_table_search" model="ir.ui.view">
        <field name="name">restaurant.table.search</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <search string="Buscar mesas">
                <field name="name"/>
                <field name="code"/>
                <filter
                    name="available"
                    string="Disponible"
                    domain="[('state', '=', 'available')]"/>
                <filter
                    name="occupied"
                    string="Ocupada"
                    domain="[('state', '=', 'occupied')]"/>
                <filter
                    name="maintenance"
                    string="Mantenimiento"
                    domain="[('state', '=', 'maintenance')]"/>
                <filter
                    name="active"
                    string="Activas"
                    domain="[('active', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_by_location"
                        string="Ubicación"
                        context="{'group_by': 'location'}"/>
                    <filter
                        name="group_by_state"
                        string="Estado"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_restaurant_table" model="ir.actions.act_window">
        <field name="name">Mesas</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_restaurant_table_search"/>
    </record>
</odoo>
