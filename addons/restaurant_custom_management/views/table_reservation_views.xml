<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_table_reservation_list" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.list</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="table_id"/>
                <field name="reservation_start"/>
                <field name="reservation_end"/>
                <field name="guest_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_table_reservation_form" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.form</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva">
                <header>
                    <button
                        name="action_confirm"
                        string="Confirmar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button
                        name="action_start"
                        string="Iniciar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'confirmed'"/>
                    <button
                        name="action_done"
                        string="Finalizar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'in_progress'"/>
                    <button
                        name="action_cancel"
                        string="Cancelar"
                        type="object"
                        invisible="state in ['done', 'cancelled', 'no_show']"/>
                    <button
                        name="action_no_show"
                        string="No asistió"
                        type="object"
                        invisible="state not in ['confirmed', 'in_progress']"/>
                    <button
                        name="action_reset_to_draft"
                        string="Volver a pendiente"
                        type="object"
                        invisible="state == 'draft'"/>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="table_id"/>
                            <field name="guest_count"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="reservation_start"/>
                            <field name="reservation_end"/>
                            <field name="duration_hours"/>
                        </group>
                        <group>
                            <field name="special_occasion"/>
                            <field name="crm_lead_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_table_reservation_search" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.search</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <search string="Buscar reservas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="table_id"/>
                <filter
                    name="draft"
                    string="Pendientes"
                    domain="[('state', '=', 'draft')]"/>
                <filter
                    name="confirmed"
                    string="Confirmadas"
                    domain="[('state', '=', 'confirmed')]"/>
                <filter
                    name="today"
                    string="Hoy"
                    domain="[
                        ('reservation_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                        ('reservation_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))
                    ]"/>
                <filter
                    name="cancelled"
                    string="Canceladas"
                    domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_by_state"
                        string="Estado"
                        context="{'group_by': 'state'}"/>
                    <filter
                        name="group_by_table"
                        string="Mesa"
                        context="{'group_by': 'table_id'}"/>
                    <filter
                        name="group_by_responsible"
                        string="Responsable"
                        context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_table_reservation_calendar" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.calendar</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <calendar
                string="Reservas de mesa"
                date_start="reservation_start"
                date_stop="reservation_end"
                color="table_id">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="table_id"/>
                <field name="guest_count"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_restaurant_table_reservation" model="ir.actions.act_window">
        <field name="name">Reservas de mesa</field>
        <field name="res_model">restaurant.table.reservation</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_table_reservation_search"/>
    </record>
</odoo>
