<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_driver_performance_list" model="ir.ui.view">
        <field name="name">res.users.delivery.driver.performance.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Desempeño de repartidores" create="false" edit="false">
                <field name="name"/>
                <field name="driver_rating_avg"/>
                <field name="driver_rating_count"/>
                <field name="driver_polite_pct"/>
                <field name="driver_on_time_pct"/>
                <field name="driver_good_condition_pct"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_driver_performance" model="ir.actions.act_window">
        <field name="name">Desempeño de repartidores</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_delivery_driver_performance_list"/>
        <field name="domain">[('groups_id', 'in', [ref('restaurant_casa_vieja_base.group_restaurant_repartidor')])]</field>
        <field name="groups_id" eval="[
            (4, ref('restaurant_casa_vieja_base.group_restaurant_administrador')),
            (4, ref('restaurant_casa_vieja_base.group_restaurant_administracion')),
            (4, ref('restaurant_casa_vieja_base.group_restaurant_mesero'))
        ]"/>
    </record>

    <menuitem
        id="menu_delivery_reports"
        name="Reportes"
        parent="restaurant_casa_vieja_base.menu_restaurant_casa_vieja_root"
        groups="restaurant_casa_vieja_base.group_restaurant_administrador,restaurant_casa_vieja_base.group_restaurant_administracion,restaurant_casa_vieja_base.group_restaurant_mesero"
        sequence="30"/>

    <menuitem
        id="menu_delivery_driver_performance"
        name="Desempeño repartidores"
        parent="menu_delivery_reports"
        action="action_delivery_driver_performance"
        groups="restaurant_casa_vieja_base.group_restaurant_administrador,restaurant_casa_vieja_base.group_restaurant_administracion,restaurant_casa_vieja_base.group_restaurant_mesero"
        sequence="10"/>
</odoo>
