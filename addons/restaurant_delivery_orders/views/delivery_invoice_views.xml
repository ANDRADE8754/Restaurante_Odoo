<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_delivery_invoices" model="ir.actions.act_window">
        <field name="name">Facturas de delivery</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('delivery_order_id', '!=', False), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <menuitem
        id="menu_delivery_invoices"
        name="Facturas"
        parent="menu_delivery_operations"
        action="action_delivery_invoices"
        sequence="20"
        groups="restaurant_casa_vieja_base.group_restaurant_administrador,restaurant_casa_vieja_base.group_restaurant_administracion"/>
</odoo>
