<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_cancel_wizard_form" model="ir.ui.view">
        <field name="name">restaurant.delivery.cancel.wizard.form</field>
        <field name="model">restaurant.delivery.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar cancelación de pedido">
                <group>
                    <field name="delivery_order_id"/>
                    <field name="delivery_state"/>
                    <field name="cancel_reason" placeholder="Detalle el motivo de la cancelación..."/>
                    <field name="notify_customer"/>
                </group>
                <footer>
                    <button
                        name="action_confirm_cancel"
                        string="Confirmar cancelación"
                        type="object"
                        class="btn-danger"
                    />
                    <button string="Descartar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
