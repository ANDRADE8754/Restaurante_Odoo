<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categorías de ingredientes -->
        <record id="cat_verduras" model="ingredient.category">
            <field name="name">Verduras y Frutas</field>
            <field name="description">Verduras frescas, frutas y tubérculos</field>
        </record>
        <record id="cat_proteinas" model="ingredient.category">
            <field name="name">Proteínas</field>
            <field name="description">Carnes, aves, mariscos y derivados</field>
        </record>
        <record id="cat_lacteos" model="ingredient.category">
            <field name="name">Lácteos</field>
            <field name="description">Queso, leche, crema y derivados</field>
        </record>
        <record id="cat_condimentos" model="ingredient.category">
            <field name="name">Condimentos y Especias</field>
            <field name="description">Sal, pimienta, ajo, hierbas aromáticas</field>
        </record>
        <record id="cat_aceites" model="ingredient.category">
            <field name="name">Aceites y Grasas</field>
            <field name="description">Aceite de oliva, mantequilla, manteca</field>
        </record>
        <record id="cat_bebidas" model="ingredient.category">
            <field name="name">Bebidas</field>
            <field name="description">Jugos, agua, refrescos, bebidas alcohólicas</field>
        </record>

        <!-- Ingredientes de demostración - Verduras -->
        <record id="ing_papa" model="restaurant.ingredient">
            <field name="name">Papa Blanca</field>
            <field name="category_id" ref="cat_verduras"/>
            <field name="description">Papa común para fritura y cocción</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">0.50</field>
            <field name="minimum_quantity">20</field>
            <field name="maximum_quantity">100</field>
            <field name="reorder_quantity">50</field>
            <field name="expiration_control">True</field>
        </record>
        <record id="ing_cebolla" model="restaurant.ingredient">
            <field name="name">Cebolla Blanca</field>
            <field name="category_id" ref="cat_verduras"/>
            <field name="description">Cebolla fresca para preparaciones</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">0.60</field>
            <field name="minimum_quantity">10</field>
            <field name="maximum_quantity">50</field>
            <field name="reorder_quantity">30</field>
        </record>
        <record id="ing_tomate" model="restaurant.ingredient">
            <field name="name">Tomate Rojo</field>
            <field name="category_id" ref="cat_verduras"/>
            <field name="description">Tomate fresco maduro</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">0.80</field>
            <field name="minimum_quantity">15</field>
            <field name="maximum_quantity">60</field>
            <field name="reorder_quantity">40</field>
            <field name="expiration_control">True</field>
        </record>
        <record id="ing_lechuga" model="restaurant.ingredient">
            <field name="name">Lechuga Fresca</field>
            <field name="category_id" ref="cat_verduras"/>
            <field name="description">Lechuga verde para ensaladas</field>
            <field name="unit_of_measure">unit</field>
            <field name="unit_cost">1.20</field>
            <field name="minimum_quantity">10</field>
            <field name="maximum_quantity">40</field>
            <field name="reorder_quantity">20</field>
            <field name="expiration_control">True</field>
        </record>

        <!-- Ingredientes de demostración - Proteínas -->
        <record id="ing_pollo" model="restaurant.ingredient">
            <field name="name">Pechuga de Pollo</field>
            <field name="category_id" ref="cat_proteinas"/>
            <field name="description">Pollo fresco sin piel</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">5.50</field>
            <field name="minimum_quantity">10</field>
            <field name="maximum_quantity">50</field>
            <field name="reorder_quantity">30</field>
            <field name="expiration_control">True</field>
        </record>
        <record id="ing_carne" model="restaurant.ingredient">
            <field name="name">Carne de Res</field>
            <field name="category_id" ref="cat_proteinas"/>
            <field name="description">Carne molida para preparaciones</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">8.00</field>
            <field name="minimum_quantity">10</field>
            <field name="maximum_quantity">40</field>
            <field name="reorder_quantity">25</field>
            <field name="expiration_control">True</field>
        </record>
        <record id="ing_huevo" model="restaurant.ingredient">
            <field name="name">Huevos de Granja</field>
            <field name="category_id" ref="cat_proteinas"/>
            <field name="description">Huevos frescos de granja</field>
            <field name="unit_of_measure">dozen</field>
            <field name="unit_cost">2.50</field>
            <field name="minimum_quantity">6</field>
            <field name="maximum_quantity">24</field>
            <field name="reorder_quantity">12</field>
            <field name="expiration_control">True</field>
        </record>

        <!-- Ingredientes de demostración - Lácteos -->
        <record id="ing_queso" model="restaurant.ingredient">
            <field name="name">Queso Fresco</field>
            <field name="category_id" ref="cat_lacteos"/>
            <field name="description">Queso fresco ecuatoriano</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">6.50</field>
            <field name="minimum_quantity">5</field>
            <field name="maximum_quantity">25</field>
            <field name="reorder_quantity">15</field>
            <field name="expiration_control">True</field>
        </record>
        <record id="ing_leche" model="restaurant.ingredient">
            <field name="name">Leche Fresca</field>
            <field name="category_id" ref="cat_lacteos"/>
            <field name="description">Leche pasteurizada</field>
            <field name="unit_of_measure">l</field>
            <field name="unit_cost">1.00</field>
            <field name="minimum_quantity">10</field>
            <field name="maximum_quantity">50</field>
            <field name="reorder_quantity">30</field>
            <field name="expiration_control">True</field>
        </record>

        <!-- Ingredientes de demostración - Condimentos -->
        <record id="ing_sal" model="restaurant.ingredient">
            <field name="name">Sal de Cocina</field>
            <field name="category_id" ref="cat_condimentos"/>
            <field name="description">Sal refinada</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">0.75</field>
            <field name="minimum_quantity">2</field>
            <field name="maximum_quantity">10</field>
            <field name="reorder_quantity">5</field>
        </record>
        <record id="ing_ajo" model="restaurant.ingredient">
            <field name="name">Ajo Fresco</field>
            <field name="category_id" ref="cat_condimentos"/>
            <field name="description">Ajo blanco para preparaciones</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">2.00</field>
            <field name="minimum_quantity">2</field>
            <field name="maximum_quantity">10</field>
            <field name="reorder_quantity">5</field>
        </record>
        <record id="ing_cilantro" model="restaurant.ingredient">
            <field name="name">Cilantro Fresco</field>
            <field name="category_id" ref="cat_condimentos"/>
            <field name="description">Cilantro para guarnición y sabor</field>
            <field name="unit_of_measure">unit</field>
            <field name="unit_cost">0.30</field>
            <field name="minimum_quantity">5</field>
            <field name="maximum_quantity">20</field>
            <field name="reorder_quantity">10</field>
            <field name="expiration_control">True</field>
        </record>

        <!-- Ingredientes de demostración - Aceites -->
        <record id="ing_aceite" model="restaurant.ingredient">
            <field name="name">Aceite de Cocina</field>
            <field name="category_id" ref="cat_aceites"/>
            <field name="description">Aceite vegetal para fritura</field>
            <field name="unit_of_measure">l</field>
            <field name="unit_cost">2.50</field>
            <field name="minimum_quantity">5</field>
            <field name="maximum_quantity">30</field>
            <field name="reorder_quantity">15</field>
        </record>
        <record id="ing_mantequilla" model="restaurant.ingredient">
            <field name="name">Mantequilla</field>
            <field name="category_id" ref="cat_aceites"/>
            <field name="description">Mantequilla sin sal</field>
            <field name="unit_of_measure">kg</field>
            <field name="unit_cost">6.00</field>
            <field name="minimum_quantity">2</field>
            <field name="maximum_quantity">10</field>
            <field name="reorder_quantity">5</field>
            <field name="expiration_control">True</field>
        </record>

        <!-- Ingredientes de demostración - Bebidas -->
        <record id="ing_agua" model="restaurant.ingredient">
            <field name="name">Agua Mineral</field>
            <field name="category_id" ref="cat_bebidas"/>
            <field name="description">Agua mineral embotellada 500ml</field>
            <field name="unit_of_measure">unit</field>
            <field name="unit_cost">0.50</field>
            <field name="minimum_quantity">20</field>
            <field name="maximum_quantity">100</field>
            <field name="reorder_quantity">50</field>
        </record>
        <record id="ing_jugo" model="restaurant.ingredient">
            <field name="name">Jugo Natural de Naranja</field>
            <field name="category_id" ref="cat_bebidas"/>
            <field name="description">Jugo concentrado de naranja</field>
            <field name="unit_of_measure">l</field>
            <field name="unit_cost">3.00</field>
            <field name="minimum_quantity">5</field>
            <field name="maximum_quantity">20</field>
            <field name="reorder_quantity">10</field>
            <field name="expiration_control">True</field>
        </record>
    </data>
</odoo>
