<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista de categorías -->
        <record id="view_ingredient_category_tree" model="ir.ui.view">
            <field name="name">Categorías de Ingredientes - Lista</field>
            <field name="model">ingredient.category</field>
            <field name="arch" type="xml">
                <list string="Categorías">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario de categoría -->
        <record id="view_ingredient_category_form" model="ir.ui.view">
            <field name="name">Categoría - Formulario</field>
            <field name="model">ingredient.category</field>
            <field name="arch" type="xml">
                <form string="Categoría de Ingrediente">
                    <sheet>
                        <group>
                            <field name="active"/>
                        </group>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción para abrir categorías -->
        <record id="action_ingredient_category" model="ir.actions.act_window">
            <field name="name">Categorías de Ingredientes</field>
            <field name="res_model">ingredient.category</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
