<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista de ingredientes -->
        <record id="view_restaurant_ingredient_tree" model="ir.ui.view">
            <field name="name">Ingredientes - Lista</field>
            <field name="model">restaurant.ingredient</field>
            <field name="arch" type="xml">
                <list string="Ingredientes" decoration-danger="stock_state == 'critical'" decoration-warning="stock_state == 'low'" decoration-success="stock_state == 'ok'">
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="quantity_on_hand"/>
                    <field name="unit_of_measure"/>
                    <field name="minimum_quantity"/>
                    <field name="stock_state"/>
                    <field name="unit_cost"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario de ingrediente -->
        <record id="view_restaurant_ingredient_form" model="ir.ui.view">
            <field name="name">Ingrediente - Formulario</field>
            <field name="model">restaurant.ingredient</field>
            <field name="arch" type="xml">
                <form string="Ingrediente">
                    <header>
                        <button name="action_reorder" string="Crear Orden de Compra" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="active"/>
                        </group>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="category_id"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="stock_state" widget="badge" decoration-danger="stock_state == 'critical'" decoration-warning="stock_state == 'low'" decoration-success="stock_state == 'ok'"/>
                                <field name="quantity_on_hand"/>
                                <field name="unit_of_measure"/>
                            </group>
                        </group>

                        <group string="Precios y Costos">
                            <group>
                                <field name="unit_cost"/>
                            </group>
                        </group>

                        <group string="Control de Stock">
                            <group>
                                <field name="minimum_quantity"/>
                                <field name="maximum_quantity"/>
                                <field name="reorder_quantity"/>
                            </group>
                        </group>

                        <group string="Información de Proveedores">
                            <group>
                                <field name="supplier_id"/>
                                <field name="lead_time_days"/>
                            </group>
                        </group>

                        <group string="Información Adicional">
                            <group>
                                <field name="expiration_control"/>
                                <field name="last_stock_check"/>
                            </group>
                            <group>
                                <field name="allergen_info" nolabel="1" colspan="2"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de búsqueda -->
        <record id="view_restaurant_ingredient_search" model="ir.ui.view">
            <field name="name">Ingredientes - Búsqueda</field>
            <field name="model">restaurant.ingredient</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Ingrediente"/>
                    <field name="category_id" string="Categoría"/>
                    <separator/>
                    <filter name="in_stock" string="En Stock" domain="[('stock_state', '=', 'ok')]"/>
                    <filter name="low_stock" string="Stock Bajo" domain="[('stock_state', '=', 'low')]"/>
                    <filter name="critical_stock" string="Stock Crítico" domain="[('stock_state', '=', 'critical')]"/>
                </search>
            </field>
        </record>

        <!-- Acción para abrir ingredientes -->
        <record id="action_restaurant_ingredient" model="ir.actions.act_window">
            <field name="name">Ingredientes</field>
            <field name="res_model">restaurant.ingredient</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_restaurant_ingredient_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registrar un nuevo ingrediente
                </p>
            </field>
        </record>
    </data>
</odoo>
