<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Plantilla para listar categorías -->
        <template id="inventory_categories_template" name="Categorías de Ingredientes">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-10 offset-lg-1">
                            <h1 class="mb-4">📦 Inventario de Ingredientes</h1>
                            <p class="lead">Explora nuestros ingredientes frescos y de calidad</p>
                            
                            <div class="row mb-4">
                                <div class="col-lg-4">
                                    <a href="/restaurant/inventory/status" class="btn btn-info btn-lg btn-block">
                                        Ver Estado General
                                    </a>
                                </div>
                            </div>
                            
                            <h2 class="mb-3">Categorías Disponibles</h2>
                            <div class="row">
                                <t t-foreach="categories" t-as="cat">
                                    <div class="col-lg-6 mb-4">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body">
                                                <h5 class="card-title"><t t-esc="cat.name"/></h5>
                                                <p class="card-text"><t t-esc="cat.description"/></p>
                                            </div>
                                            <div class="card-footer bg-white">
                                                <a t-att-href="'/restaurant/inventory/category/%d' % cat.id" class="btn btn-primary">
                                                    Ver Ingredientes
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para ver detalle de categoría -->
        <template id="inventory_category_detail_template" name="Ingredientes de Categoría">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-10 offset-lg-1">
                            <a href="/restaurant/inventory/categories" class="btn btn-secondary mb-4">← Volver a Categorías</a>
                            
                            <h1 class="mb-4"><t t-esc="category.name"/></h1>
                            <p class="lead text-muted"><t t-esc="category.description"/></p>
                            
                            <h2 class="mb-3">Ingredientes disponibles</h2>
                            <t t-if="ingredients">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Stock Actual</th>
                                                <th>Unidad</th>
                                                <th>Estado</th>
                                                <th>Precio</th>
                                                <th>Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="ingredients" t-as="ing">
                                                <td>
                                                    <strong><t t-esc="ing.name"/></strong>
                                                    <br/>
                                                    <small class="text-muted"><t t-esc="ing.description"/></small>
                                                </td>
                                                <td>
                                                    <t t-esc="ing.quantity_on_hand"/>
                                                </td>
                                                <td><t t-esc="ing.unit_of_measure"/></td>
                                                <td>
                                                    <t t-if="ing.stock_state == 'critical'">
                                                        <span class="badge bg-danger">Crítico</span>
                                                    </t>
                                                    <t t-elif="ing.stock_state == 'low'">
                                                        <span class="badge bg-warning">Bajo</span>
                                                    </t>
                                                    <t t-elif="ing.stock_state == 'ok'">
                                                        <span class="badge bg-success">Disponible</span>
                                                    </t>
                                                </td>
                                                <td>$<span t-field="ing.unit_cost"/></td>
                                                <td>
                                                    <a t-att-href="'/restaurant/inventory/ingredient/%d' % ing.id" class="btn btn-sm btn-info">
                                                        Detalles
                                                    </a>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <t t-else="">
                                <p class="alert alert-info">No hay ingredientes en esta categoría.</p>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para detalles del ingrediente -->
        <template id="ingredient_detail_template" name="Detalles del Ingrediente">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <a t-att-href="'/restaurant/inventory/category/%d' % ingredient.category_id.id" class="btn btn-secondary mb-4">
                                ← Volver a <t t-esc="ingredient.category_id.name"/>
                            </a>
                            
                            <div class="card shadow-lg">
                                <div class="card-body">
                                    <h1 class="card-title mb-4"><t t-esc="ingredient.name"/></h1>
                                    
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <h5>Información</h5>
                                            <p><strong>Categoría:</strong> <t t-esc="ingredient.category_id.name"/></p>
                                            <p><strong>Descripción:</strong> <t t-esc="ingredient.description"/></p>
                                            <p><strong>Unidad de Medida:</strong> <t t-esc="ingredient.unit_of_measure"/></p>
                                        </div>
                                        <div class="col-md-6">
                                            <h5>Stock</h5>
                                            <p class="h3">
                                                <strong><t t-esc="ingredient.quantity_on_hand"/></strong> 
                                                <small><t t-esc="ingredient.unit_of_measure"/></small>
                                            </p>
                                            <p>
                                                <t t-if="ingredient.stock_state == 'critical'">
                                                    <span class="badge bg-danger p-2">Stock Crítico</span>
                                                </t>
                                                <t t-elif="ingredient.stock_state == 'low'">
                                                    <span class="badge bg-warning p-2">Stock Bajo</span>
                                                </t>
                                                <t t-elif="ingredient.stock_state == 'ok'">
                                                    <span class="badge bg-success p-2">Stock Disponible</span>
                                                </t>
                                            </p>
                                        </div>
                                    </div>
                                    
                                    <hr/>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5>Precios y Costos</h5>
                                            <p><strong>Costo Unitario:</strong> $<span t-field="ingredient.unit_cost"/></p>
                                            <p><strong>Costo Total:</strong> $<t t-esc="ingredient.quantity_on_hand * ingredient.unit_cost"/></p>
                                        </div>
                                        <div class="col-md-6">
                                            <h5>Control de Stock</h5>
                                            <p><strong>Cantidad Mínima:</strong> <t t-esc="ingredient.minimum_quantity"/> <t t-esc="ingredient.unit_of_measure"/></p>
                                            <p><strong>Cantidad Máxima:</strong> <t t-esc="ingredient.maximum_quantity"/> <t t-esc="ingredient.unit_of_measure"/></p>
                                            <p><strong>Cantidad de Reorden:</strong> <t t-esc="ingredient.reorder_quantity"/> <t t-esc="ingredient.unit_of_measure"/></p>
                                        </div>
                                    </div>
                                    
                                    <hr/>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Control de Expiración:</strong> 
                                                <t t-if="ingredient.expiration_control">
                                                    <span class="badge bg-info">Sí</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-secondary">No</span>
                                                </t>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Información de Alérgenos:</strong> 
                                                <t t-esc="ingredient.allergen_info or 'Ninguno reportado'"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <a href="/restaurant/inventory/categories" class="btn btn-primary mt-4">
                                Volver al Inventario
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para estado general del inventario -->
        <template id="inventory_status_template" name="Estado General del Inventario">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-10 offset-lg-1">
                            <a href="/restaurant/inventory/categories" class="btn btn-secondary mb-4">← Volver a Categorías</a>
                            
                            <h1 class="mb-4">📊 Estado General del Inventario</h1>
                            
                            <div class="row mb-4">
                                <div class="col-lg-4">
                                    <div class="card bg-success text-white">
                                        <div class="card-body text-center">
                                            <h3 class="card-title"><t t-esc="len(ok)"/></h3>
                                            <p class="card-text">Ingredientes Disponibles</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="card bg-warning text-white">
                                        <div class="card-body text-center">
                                            <h3 class="card-title"><t t-esc="len(low)"/></h3>
                                            <p class="card-text">Stock Bajo</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="card bg-danger text-white">
                                        <div class="card-body text-center">
                                            <h3 class="card-title"><t t-esc="len(critical)"/></h3>
                                            <p class="card-text">Stock Crítico</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <h2 class="mb-3">📍 Ingredientes Críticos (Requieren Reorden)</h2>
                            <t t-if="critical">
                                <div class="alert alert-danger">
                                    <ul>
                                        <li t-foreach="critical" t-as="ing">
                                            <strong><t t-esc="ing.name"/></strong> - 
                                            Stock: <t t-esc="ing.quantity_on_hand"/> <t t-esc="ing.unit_of_measure"/>
                                            (Mínimo: <t t-esc="ing.minimum_quantity"/>)
                                        </li>
                                    </ul>
                                </div>
                            </t>
                            <t t-else="">
                                <p class="alert alert-success">✓ No hay ingredientes con stock crítico</p>
                            </t>
                            
                            <h2 class="mb-3">⚠️ Ingredientes con Stock Bajo</h2>
                            <t t-if="low">
                                <div class="alert alert-warning">
                                    <ul>
                                        <li t-foreach="low" t-as="ing">
                                            <strong><t t-esc="ing.name"/></strong> - 
                                            Stock: <t t-esc="ing.quantity_on_hand"/> <t t-esc="ing.unit_of_measure"/>
                                            (Mínimo: <t t-esc="ing.minimum_quantity"/>)
                                        </li>
                                    </ul>
                                </div>
                            </t>
                            <t t-else="">
                                <p class="alert alert-info">Todos los ingredientes con stock bajo han sido resueltos</p>
                            </t>
                            
                            <h2 class="mb-3">✓ Inventario Completo</h2>
                            <div class="table-responsive">
                                <table class="table table-striped table-sm">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Ingrediente</th>
                                            <th>Categoría</th>
                                            <th>Stock</th>
                                            <th>Estado</th>
                                            <th>Detalles</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="ingredients" t-as="ing">
                                            <td><t t-esc="ing.name"/></td>
                                            <td><t t-esc="ing.category_id.name"/></td>
                                            <td><t t-esc="ing.quantity_on_hand"/> <t t-esc="ing.unit_of_measure"/></td>
                                            <td>
                                                <t t-if="ing.stock_state == 'critical'">
                                                    <span class="badge bg-danger">Crítico</span>
                                                </t>
                                                <t t-elif="ing.stock_state == 'low'">
                                                    <span class="badge bg-warning">Bajo</span>
                                                </t>
                                                <t t-elif="ing.stock_state == 'ok'">
                                                    <span class="badge bg-success">OK</span>
                                                </t>
                                            </td>
                                            <td>
                                                <a t-att-href="'/restaurant/inventory/ingredient/%d' % ing.id" class="btn btn-sm btn-outline-info">
                                                    Ver
                                                </a>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
