<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista de pedidos -->
        <record id="view_restaurant_order_tree" model="ir.ui.view">
            <field name="name">Pedidos a Domicilio - Lista</field>
            <field name="model">restaurant.order</field>
            <field name="arch" type="xml">
                <list string="Pedidos a Domicilio">
                    <field name="order_number"/>
                    <field name="partner_id"/>
                    <field name="delivery_date"/>
                    <field name="state" decoration-danger="state == 'cancelled'" decoration-success="state == 'delivered'"/>
                    <field name="total_amount" sum="Total"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario de pedido -->
        <record id="view_restaurant_order_form" model="ir.ui.view">
            <field name="name">Pedido a Domicilio - Formulario</field>
            <field name="model">restaurant.order</field>
            <field name="arch" type="xml">
                <form string="Pedido a Domicilio">
                    <header>
                        <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                        <button name="action_preparing" string="Iniciar Preparación" type="object" class="btn-primary"/>
                        <button name="action_ready" string="Marcar Listo" type="object" class="btn-primary"/>
                        <button name="action_on_way" string="Salió a Entregar" type="object" class="btn-primary"/>
                        <button name="action_delivered" string="Entregado" type="object" class="btn-success"/>
                        <button name="action_cancel" string="Cancelar" type="object" class="btn-danger"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,preparing,ready,on_way,delivered"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="order_number"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="order_date"/>
                                <field name="estimated_delivery_time"/>
                                <field name="delivery_date"/>
                            </group>
                        </group>

                        <group string="Dirección de Entrega">
                            <group>
                                <field name="delivery_address" nolabel="1"/>
                                <field name="delivery_city"/>
                            </group>
                            <group>
                                <field name="delivery_person_id"/>
                                <field name="delivery_notes" nolabel="1" colspan="2"/>
                            </group>
                        </group>

                        <field name="order_line_ids" string="Productos">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                                <field name="notes"/>
                                <field name="price_subtotal"/>
                            </list>
                        </field>

                        <group class="oe_subtotal_footer oe_right">
                            <div class="oe_subtotal_footer_separator">
                                <span class="oe_summary_total_sell">Total:</span>
                            </div>
                            <field name="total_amount" nolabel="1" class="oe_summary_total_sell"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de búsqueda -->
        <record id="view_restaurant_order_search" model="ir.ui.view">
            <field name="name">Pedidos a Domicilio - Búsqueda</field>
            <field name="model">restaurant.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="order_number" string="Número de Pedido"/>
                    <field name="partner_id" string="Cliente"/>
                    <field name="delivery_date"/>
                    <separator/>
                    <filter name="pending" string="Pendiente" domain="[('state', '=', 'pending')]"/>
                    <filter name="preparing" string="En Preparación" domain="[('state', '=', 'preparing')]"/>
                    <filter name="ready" string="Listo" domain="[('state', '=', 'ready')]"/>
                    <filter name="on_way" string="En Camino" domain="[('state', '=', 'on_way')]"/>
                    <filter name="delivered" string="Entregado" domain="[('state', '=', 'delivered')]"/>
                </search>
            </field>
        </record>

        <!-- Acción para abrir la vista -->
        <record id="action_restaurant_order" model="ir.actions.act_window">
            <field name="name">Pedidos a Domicilio</field>
            <field name="res_model">restaurant.order</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_restaurant_order_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo pedido a domicilio
                </p>
            </field>
        </record>
    </data>
</odoo>
