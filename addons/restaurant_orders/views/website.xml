<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Plantilla para formulario de crear pedido -->
        <template id="order_form_template" name="Crear Pedido a Domicilio">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <h1 class="mb-4">Realizar Pedido a Domicilio</h1>
                            <form method="POST" action="/restaurant/order/create" class="needs-validation">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                
                                <div class="mb-3">
                                    <label for="delivery_address" class="form-label">Dirección de Entrega</label>
                                    <input type="text" class="form-control" id="delivery_address" name="delivery_address" required="required"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="delivery_city" class="form-label">Ciudad</label>
                                    <input type="text" class="form-control" id="delivery_city" name="delivery_city" value="Patate"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="estimated_delivery_time" class="form-label">Tiempo de Entrega (minutos)</label>
                                    <input type="number" class="form-control" id="estimated_delivery_time" name="estimated_delivery_time" value="45" min="15" max="120"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="delivery_notes" class="form-label">Notas Especiales</label>
                                    <textarea class="form-control" id="delivery_notes" name="delivery_notes" rows="3"></textarea>
                                </div>
                                
                                <button type="submit" class="btn btn-primary btn-lg">Crear Pedido</button>
                                <a href="/restaurant/orders" class="btn btn-secondary btn-lg">Ver Mis Pedidos</a>
                            </form>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para ver detalle del pedido -->
        <template id="order_detail_template" name="Detalle de Pedido">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <h1 class="mb-4">Pedido <t t-esc="order.order_number"/></h1>
                            
                            <div class="card mb-4">
                                <div class="card-body">
                                    <h5 class="card-title">Estado: <span t-field="order.state" class="badge bg-info"/></h5>
                                    <p><strong>Cliente:</strong> <t t-esc="order.partner_id.name"/></p>
                                    <p><strong>Dirección:</strong> <t t-esc="order.delivery_address"/></p>
                                    <p><strong>Ciudad:</strong> <t t-esc="order.delivery_city"/></p>
                                    <p><strong>Fecha de Pedido:</strong> <t t-field="order.order_date" t-options='{"widget": "datetime"}'/></p>
                                    <p><strong>Entrega Estimada:</strong> <t t-field="order.delivery_date" t-options='{"widget": "datetime"}'/></p>
                                    <p><strong>Total:</strong> $<t t-field="order.total_amount"/></p>
                                </div>
                            </div>
                            
                            <a href="/restaurant/orders" class="btn btn-secondary">Volver a Mis Pedidos</a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para listar pedidos -->
        <template id="orders_list_template" name="Mis Pedidos">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-10 offset-lg-1">
                            <h1 class="mb-4">Mis Pedidos a Domicilio</h1>
                            
                            <a href="/restaurant/order/create" class="btn btn-primary mb-4">Nuevo Pedido</a>
                            
                            <t t-if="orders">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Número</th>
                                            <th>Dirección</th>
                                            <th>Estado</th>
                                            <th>Total</th>
                                            <th>Fecha</th>
                                            <th>Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="orders" t-as="order">
                                            <td><t t-esc="order.order_number"/></td>
                                            <td><t t-esc="order.delivery_address"/></td>
                                            <td><span t-field="order.state" class="badge bg-info"/></td>
                                            <td>$<span t-field="order.total_amount"/></td>
                                            <td><span t-field="order.order_date" t-options='{"widget": "date"}'/></td>
                                            <td><a t-att-href="'/restaurant/order/%d' % order.id" class="btn btn-sm btn-info">Ver</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="alert alert-info">No tienes pedidos. <a href="/restaurant/order/create">Crear uno ahora</a></p>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Menú de Navegación -->
        <record id="menu_restaurant_root" model="website.menu">
            <field name="name">🍽️ Restaurante</field>
            <field name="url">/restaurant/orders</field>
            <field name="parent_id" ref="website.menu_homepage"/>
            <field name="sequence">1</field>
        </record>

        <record id="menu_restaurant_orders_create" model="website.menu">
            <field name="name">Hacer un Pedido</field>
            <field name="url">/restaurant/order/create</field>
            <field name="parent_id" ref="menu_restaurant_root"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_restaurant_orders_list" model="website.menu">
            <field name="name">Mis Pedidos</field>
            <field name="url">/restaurant/orders</field>
            <field name="parent_id" ref="menu_restaurant_root"/>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
