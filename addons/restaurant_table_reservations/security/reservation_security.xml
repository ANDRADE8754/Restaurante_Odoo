<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_restaurant_reservations" model="ir.module.category">
            <field name="name">Reservas Casa Vieja</field>
            <field name="description">Acceso al modulo de reservas de mesa del Restaurante Casa Vieja.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_restaurant_reservation_user" model="res.groups">
            <field name="name">Usuario de Reservas</field>
            <field name="category_id" ref="module_category_restaurant_reservations"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Crea y edita reservas de mesa, solo lee mesas.</field>
        </record>

        <record id="group_restaurant_reservation_manager" model="res.groups">
            <field name="name">Responsable de Reservas</field>
            <field name="category_id" ref="module_category_restaurant_reservations"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_restaurant_reservation_user'))]"/>
            <field name="comment">Gestiona reservas y mesas del restaurante.</field>
        </record>

        <record id="rule_restaurant_table_company" model="ir.rule">
            <field name="name">Mesas: multi-compania</field>
            <field name="model_id" ref="model_restaurant_table"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_table_reservation_company" model="ir.rule">
            <field name="name">Reservas: multi-compania</field>
            <field name="model_id" ref="model_restaurant_table_reservation"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
