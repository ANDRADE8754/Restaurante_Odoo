<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_table_list" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list string="Mesas del restaurante">
                <field name="name"/>
                <field name="code"/>
                <field name="floor_id" optional="hide"/>
                <field name="location_area"/>
                <field name="capacity"/>
                <field name="current_reservation_count"/>
                <field name="active"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form string="Mesa">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Mesa 1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="floor_id"/>
                            <field name="location_area"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="current_reservation_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Reservas">
                            <field name="reservation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="guest_count"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_restaurant_table_search" model="ir.ui.view">
        <field name="name">restaurant.table.search</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <search string="Buscar mesas">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactivas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_area" string="Zona" context="{'group_by': 'location_area'}"/>
                    <filter name="group_floor" string="Piso POS" context="{'group_by': 'floor_id'}"/>
                    <filter name="group_company" string="Compania" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_restaurant_table" model="ir.actions.act_window">
        <field name="name">Mesas del restaurante</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_restaurant_table_search"/>
    </record>
</odoo>
