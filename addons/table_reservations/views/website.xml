<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Plantilla para ver mesas disponibles -->
        <template id="available_tables_template" name="Mesas Disponibles">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-10 offset-lg-1">
                            <h1 class="mb-4">🍽️ Mesas Disponibles</h1>
                            <p class="lead">Reserva tu mesa en Casa Vieja y disfruta de la mejor comida ecuatoriana</p>
                            
                            <div class="row">
                                <t t-foreach="tables" t-as="table">
                                    <div class="col-lg-6 mb-4">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body">
                                                <h5 class="card-title"><t t-esc="table.table_number"/></h5>
                                                <p class="card-text">
                                                    <strong>Capacidad:</strong> <t t-esc="table.capacity"/> personas<br/>
                                                    <strong>Ubicación:</strong> <t t-esc="table.location"/><br/>
                                                    <strong>Estado:</strong> <span class="badge bg-success">Disponible</span>
                                                </p>
                                                <p class="text-muted small"><t t-esc="table.description"/></p>
                                            </div>
                                            <div class="card-footer bg-white">
                                                <a href="/restaurant/reservation/create" class="btn btn-primary btn-sm">Reservar Esta Mesa</a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para formulario de crear reserva -->
        <template id="reservation_form_template" name="Crear Reserva de Mesa">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <h1 class="mb-4">Reservar Mesa en Casa Vieja</h1>
                            <form method="POST" action="/restaurant/reservation/create" class="needs-validation">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                
                                <div class="mb-3">
                                    <label for="table_id" class="form-label">Selecciona una Mesa</label>
                                    <select class="form-select" id="table_id" name="table_id" required="required">
                                        <option value="">Elige una mesa...</option>
                                        <option t-foreach="tables" t-as="table" t-att-value="table.id">
                                            <t t-esc="table.table_number"/> - <t t-esc="table.capacity"/> personas
                                        </option>
                                    </select>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="number_of_guests" class="form-label">Número de Comensales</label>
                                    <input type="number" class="form-control" id="number_of_guests" name="number_of_guests" value="2" min="1" max="20" required="required"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="reservation_datetime" class="form-label">Fecha y Hora</label>
                                    <input type="datetime-local" class="form-control" id="reservation_datetime" name="reservation_datetime" required="required"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="estimated_duration" class="form-label">Duración Estimada (minutos)</label>
                                    <input type="number" class="form-control" id="estimated_duration" name="estimated_duration" value="120" min="60" max="240"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="occasion" class="form-label">Ocasión</label>
                                    <select class="form-select" id="occasion" name="occasion">
                                        <option value="normal">Ocasión Normal</option>
                                        <option value="birthday">Cumpleaños</option>
                                        <option value="anniversary">Aniversario</option>
                                        <option value="business">Negocio</option>
                                        <option value="celebration">Celebración</option>
                                        <option value="romantic">Romántica</option>
                                        <option value="other">Otro</option>
                                    </select>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="special_requests" class="form-label">Solicitudes Especiales</label>
                                    <textarea class="form-control" id="special_requests" name="special_requests" rows="3" placeholder="Ej: Decoración especial, música, etc."></textarea>
                                </div>
                                
                                <button type="submit" class="btn btn-primary btn-lg">Reservar Mesa</button>
                                <a href="/restaurant/reservations" class="btn btn-secondary btn-lg">Ver Mis Reservas</a>
                            </form>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para ver detalle de reserva -->
        <template id="reservation_detail_template" name="Detalle de Reserva">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <h1 class="mb-4">Reserva <t t-esc="reservation.reservation_number"/></h1>
                            
                            <div class="card mb-4">
                                <div class="card-body">
                                    <h5 class="card-title">Estado: <span t-field="reservation.state" class="badge bg-info"/></h5>
                                    <p><strong>Mesa:</strong> <t t-esc="reservation.table_id.table_number"/></p>
                                    <p><strong>Comensales:</strong> <t t-esc="reservation.number_of_guests"/></p>
                                    <p><strong>Fecha y Hora:</strong> <span t-field="reservation.reservation_datetime" t-options='{"widget": "datetime"}'/></p>
                                    <p><strong>Duración Estimada:</strong> <t t-esc="reservation.estimated_duration"/> minutos</p>
                                    <p><strong>Ocasión:</strong> <t t-field="reservation.occasion"/></p>
                                    <p><strong>Solicitudes Especiales:</strong> <t t-esc="reservation.special_requests or 'Ninguna'"/></p>
                                </div>
                            </div>
                            
                            <a href="/restaurant/reservations" class="btn btn-secondary">Volver a Mis Reservas</a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Plantilla para listar reservas -->
        <template id="reservations_list_template" name="Mis Reservas">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-10 offset-lg-1">
                            <h1 class="mb-4">Mis Reservas en Casa Vieja</h1>
                            
                            <a href="/restaurant/tables/available" class="btn btn-primary mb-4">Ver Mesas Disponibles</a>
                            <a href="/restaurant/reservation/create" class="btn btn-success mb-4">Nueva Reserva</a>
                            
                            <t t-if="reservations">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Número</th>
                                            <th>Mesa</th>
                                            <th>Comensales</th>
                                            <th>Fecha</th>
                                            <th>Estado</th>
                                            <th>Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="reservations" t-as="res">
                                            <td><t t-esc="res.reservation_number"/></td>
                                            <td><t t-esc="res.table_id.table_number"/></td>
                                            <td><t t-esc="res.number_of_guests"/></td>
                                            <td><span t-field="res.reservation_datetime" t-options='{"widget": "date"}'/></td>
                                            <td><span t-field="res.state" class="badge bg-info"/></td>
                                            <td><a t-att-href="'/restaurant/reservation/%d' % res.id" class="btn btn-sm btn-info">Ver</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="alert alert-info">No tienes reservas. <a href="/restaurant/tables/available">Reservar una mesa</a></p>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Menú de Navegación -->
        <record id="menu_restaurant_reservations" model="website.menu">
            <field name="name">Reservas de Mesa</field>
            <field name="url">/restaurant/tables/available</field>
            <field name="parent_id" ref="restaurant_orders.menu_restaurant_root"/>
            <field name="sequence">30</field>
        </record>

        <record id="menu_restaurant_tables_available" model="website.menu">
            <field name="name">Mesas Disponibles</field>
            <field name="url">/restaurant/tables/available</field>
            <field name="parent_id" ref="menu_restaurant_reservations"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_restaurant_reservation_create" model="website.menu">
            <field name="name">Hacer una Reserva</field>
            <field name="url">/restaurant/reservation/create</field>
            <field name="parent_id" ref="menu_restaurant_reservations"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_restaurant_reservations_list" model="website.menu">
            <field name="name">Mis Reservas</field>
            <field name="url">/restaurant/reservations</field>
            <field name="parent_id" ref="menu_restaurant_reservations"/>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
